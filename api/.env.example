# ---------------------------------------------------------------------------
# Variables de entorno de la API (Laravel).
# ---------------------------------------------------------------------------
#
# NINGUN valor de este archivo es real. Para arrancar en desarrollo se copia a
# `.env` y se rellena. Los secretos se generan con:
#
#   openssl rand -base64 48            # para APP_KEY
#   php artisan key:generate --show
#
# El rol de base de datos NO puede ser superusuario ni tener BYPASSRLS: con
# cualquiera de las dos cosas PostgreSQL ignora las politicas de Row Level
# Security y una agencia veria los datos de otra. Lo comprueba:
#   php artisan viajes:verificar-aislamiento
# ---------------------------------------------------------------------------

APP_NAME="Agencia de Viajes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=agencia_viajes
DB_USERNAME=agencia_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=agencia_viajes_admin
DB_ADMIN_PASSWORD=

DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Redis (cache, colas y candado de contencion de asientos)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false

# Tiempo (en segundos) que un candado de contencion de asientos se mantiene
# sin que alguien lo renueve. Si se vence, el candado se libera solo; la
# garantia de que un asiento no se venda dos veces NO depende de este valor,
# sino del indice de exclusion de PostgreSQL. Ver docs/01, seccion "Bloqueo
# de asientos".
ASIENTOS_CANDADO_TTL=15

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/agencia/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTHENTIK_SCOPES="openid profile email"
# Grupo de Authentik que concede el rol de administrador de agencia.
AUTHENTIK_GRUPO_ADMIN=agencia-administradores
AUTHENTIK_ALGORITMO=RS256

# ---------------------------------------------------------------------------
# Datos personales (Ley 19.628)
# ---------------------------------------------------------------------------
# Cuantos dias se conserva la bitacora de acceso a datos sensibles.
# Cero significa que se conserva para siempre. Ver docs/07.
BITACORA_RETENCION_DIAS=1825