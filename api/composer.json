{
    "name": "hefesto/agencia-viajes",
    "type": "project",
    "description": "API de la aplicacion para agencias de viajes de Hefesto Studio. Venta de pasajes, reservas, documentacion de viaje y bloqueo de asientos. Software original de Hefesto: NO es un kit de despliegue de una herramienta de terceros.",
    "keywords": ["hefesto", "agencia-de-viajes", "multitenant", "laravel", "rls"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-bcmath": "*",
        "laravel/framework": "^13.37",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.10",
        "firebase/php-jwt": "^7.2",
        "predis/predis": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:aislamiento": [
            "@php artisan test --testsuite=Aislamiento"
        ],
        "test:asientos": [
            "@php artisan test --testsuite=Asientos"
        ],
        "test:boleto": [
            "@php artisan test --testsuite=Boleto"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}