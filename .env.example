# ---------------------------------------------------------------------------
# Variables de entorno de la AGENCIA (para `docker compose`).
# ---------------------------------------------------------------------------
#
# Esta plantilla la usan los dos compose:
#
#   docker compose -f deploy/docker-compose.dev.yml  --env-file .env      up -d
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.prod up -d
#
# En produccion se copia a `.env.prod`, que NO se versiona.
#
# NINGUN valor de este archivo es real. Los secretos se generan con:
#
#   openssl rand -base64 48                      # para APP_KEY
#   openssl rand -base64 60 | tr -d '\n'         # para AUTHENTIK_SECRET_KEY
#   openssl rand -hex 32                         # para AUTHENTIK_BOOTSTRAP__TOKEN
#   openssl rand -base64 32                      # para DB_PASSWORD y REDIS_PASSWORD
#
# Ojo: PostgreSQL no acepta contrasenas de mas de 99 caracteres
# (limitacion documentada por Authentik).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
APP_NAME="Agencia de Viajes"
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de datos de la AGENCIA
# ---------------------------------------------------------------------------
# El rol de esta conexion NO puede ser superusuario ni tener BYPASSRLS. Con
# cualquiera de las dos, PostgreSQL ignora las politicas de Row Level Security
# y una agencia veria los datos de otra, incluidos los documentos de sus
# pasajeros. Lo comprueba:
#   php artisan viajes:verificar-aislamiento
DB_DATABASE=agencia_viajes
DB_USERNAME=agencia_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=agencia_viajes_admin
DB_ADMIN_PASSWORD=

DB_HOST=postgres
DB_PORT=5432

# Solo en produccion: Redis exige contrasena en el compose de produccion.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Authentik (proveedor de identidad)
# ---------------------------------------------------------------------------
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP__EMAIL=akadmin@hefestostudio.cl
AUTHENTIK_BOOTSTRAP__PASSWORD=
AUTHENTIK_BOOTSTRAP__TOKEN=

# Base de datos propia de Authentik (no es la de la agencia).
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=

# Valores que consume la API (config/auth.php).
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/agencia/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/auth/callback
AUTHENTIK_SCOPES=openid profile email

# Grupo de Authentik que concede el rol de administrador de agencia.
# OJO: el rol FINAL sale de la tabla `usuarios`, no de este grupo. Ver docs/03.
AUTHENTIK_GRUPO_ADMIN=agencia-administradores
AUTHENTIK_ALGORITMO=RS256

# ---------------------------------------------------------------------------
# Certificados
# ---------------------------------------------------------------------------
ACME_EMAIL=admin@hefestostudio.cl

# Dominio de la instalacion. En produccion es el que sirve Caddy.
AGENCIA_DOMINIO=agencia.ejemplo.cl

# ---------------------------------------------------------------------------
# Datos personales (Ley 19.628)
# ---------------------------------------------------------------------------
# Dias que se conserva la bitacora de acceso a datos personales. Cero
# significa que se conserva para siempre. Ver docs/07.
BITACORA_RETENCION_DIAS=1825

# ---------------------------------------------------------------------------
# Solo produccion: imagenes construidas
# ---------------------------------------------------------------------------
# En produccion el compose usa imagenes ya construidas (no `build`), para que
# el despliegue sea reproducible y no dependa de que el codigo fuente este en
# el servidor.
# API_IMAGE=hefesto/agencia-api:1.0.0
# WEB_IMAGE=hefesto/agencia-web:1.0.0